<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-2.0.xsd">

  <changeSet author="vpawar" id="DE form files metadata">
    <createTable tableName="DYEXTN_FORM_FILES">
      <column name="FORM_ID" type="${int.type}">
        <constraints nullable="false" />
      </column>
      <column name="RECORD_ID" type="${int.type}">
        <constraints nullable="false" />
      </column>
      <column name="FILE_ID" type="${text.type}(128)">
        <constraints nullable="false" />
      </column>
      <column name="FILE_TYPE" type="${text.type}(128)">
        <constraints nullable="false" />
      </column>
      <column name="FILENAME" type="${text.type}(255)">
        <constraints nullable="false" />
      </column>
    </createTable>
  </changeSet>

  <changeSet author="vpawar" id="Index form files by file ID">
    <createIndex tableName="DYEXTN_FORM_FILES" indexName="DYEXTN_FORM_FILE_IDX">
      <column name="FILE_ID" />
    </createIndex>
  </changeSet>

  <changeSet author="vpawar" id="Change the file ID width to 128 chars">
    <modifyDataType tableName="DYEXTN_FORM_FILES" columnName="FILE_ID" newDataType="${string.type}(128)" />
  </changeSet>

  <changeSet author="vpawar" id="Change the file type width to 128 chars">
    <modifyDataType tableName="DYEXTN_FORM_FILES" columnName="FILE_TYPE" newDataType="${string.type}(128)" />
  </changeSet>

  <changeSet author="vpawar" id="Change the file name width to 256 chars">
    <modifyDataType tableName="DYEXTN_FORM_FILES" columnName="FILENAME" newDataType="${string.type}(256)" />
  </changeSet>
</databaseChangeLog>
