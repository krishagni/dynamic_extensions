<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-2.0.xsd">

  <changeSet author="vpawar" id="Index form files by file ID">
    <createIndex tableName="DYEXTN_FORM_FILES" indexName="DYEXTN_FORM_FILE_RECORD_IDX">
      <column name="FORM_ID" />
      <column name="RECORD_ID" />
    </createIndex>
  </changeSet>

  <changeSet author="vpawar" id="Store the object type and ID for which the file is associated">
    <addColumn tableName="DYEXTN_FORM_FILES">
      <column name="OBJECT_TYPE" type="${text.type}(255)" />
      <column name="OBJECT_ID" type="${int.type}" />
    </addColumn>
  </changeSet>
</databaseChangeLog>
